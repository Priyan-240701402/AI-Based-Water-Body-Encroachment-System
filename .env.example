# Application Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=super-secret-key-change-in-production

# Primary Database Configuration (PostgreSQL with psycopg driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/water_body_encroachment

# Upload settings
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=16777216
